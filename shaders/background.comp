#version 460
#extension GL_GOOGLE_include_directive : require

// Stage 3: local noise estimation on the difference image.
// For every pixel it computes the mean and standard deviation of the difference
// signal over an annulus: a ring from annulusInner to annulusOuter that skips the
// central core. Skipping the core matters because a real transient sits at the
// centre, and if it were included it would inflate the estimate of its own local
// noise and hide itself. The difference image also has the right noise to measure
// against: static structure has cancelled, so bright stars leave elevated photon
// noise exactly where false positives would otherwise appear, and the annulus
// picks that up and raises the local threshold there.
//
// One sigma clipping pass rejects any residual outliers from the ring.

#include "common.glsl"

layout(std430, binding = 0) readonly buffer DiffBuffer  { float diff[]; };
layout(std430, binding = 1) writeonly buffer MeanBuffer { float diffMean[]; };
layout(std430, binding = 2) writeonly buffer StdBuffer  { float diffStd[]; };

struct RingStats {
    float mean;
    float sigma;
};

// Mean and standard deviation of the annulus samples around (x, y). Coordinates are
// clamped to the frame, so the ring is complete at the edges too. With clip set,
// only samples within three sigma of the given estimate are counted. With fewer
// than two samples left the estimate is returned as is.
RingStats ringStats(int x, int y, bool clip, RingStats estimate) {
    int w = int(pc.width);
    int h = int(pc.height);
    int rOuter = pc.annulusOuter;
    int outer2 = rOuter * rOuter;
    int inner2 = pc.annulusInner * pc.annulusInner;
    float lo = estimate.mean - 3.0 * estimate.sigma;
    float hi = estimate.mean + 3.0 * estimate.sigma;

    float sum = 0.0;
    float sumSq = 0.0;
    float count = 0.0;
    for (int dy = -rOuter; dy <= rOuter; ++dy) {
        for (int dx = -rOuter; dx <= rOuter; ++dx) {
            int rr = dx * dx + dy * dy;
            if (rr <= inner2 || rr > outer2) {
                continue;
            }
            int nx = clamp(x + dx, 0, w - 1);
            int ny = clamp(y + dy, 0, h - 1);
            float v = diff[ny * w + nx];
            if (!clip || (v >= lo && v <= hi)) {
                sum += v;
                sumSq += v * v;
                count += 1.0;
            }
        }
    }

    if (count <= 1.0) {
        return estimate;
    }
    float mean = sum / count;
    return RingStats(mean, sqrt(max(sumSq / count - mean * mean, 0.0)));
}

void main() {
    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;
    if (gx >= pc.width || gy >= pc.height) {
        return;
    }
    uint i = gy * pc.width + gx;

    if (pc.hasPrev == 0u) {
        diffMean[i] = 0.0;
        diffStd[i] = 1.0;
        return;
    }

    int x = int(gx);
    int y = int(gy);

    // First pass over the whole ring, then one pass clipped around that estimate.
    // clip is a constant at both call sites, so the range test costs nothing in the
    // first pass once the driver has inlined the function.
    RingStats stats = ringStats(x, y, false, RingStats(0.0, 1.0));
    stats = ringStats(x, y, true, stats);

    diffMean[i] = stats.mean;
    diffStd[i] = max(stats.sigma, 1e-3);
}
