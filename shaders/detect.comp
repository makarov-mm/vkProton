#version 460
#extension GL_GOOGLE_include_directive : require

// Stage 4: transient detection on the difference image.
// A pixel is reported when four conditions hold:
//   1. the difference is a positive excursion (something brightened)
//   2. its significance (value minus local mean over local noise) exceeds
//      detectSigma, using the annulus statistics from the previous stage
//   3. it is a local maximum of the difference in its 3x3 neighbourhood
//   4. its four neighbours in the difference are also elevated, at least
//      shapeRatio times the centre, which is true for a point spread function
//      but not for a single pixel noise spike
// Survivors are appended to a shared list through an atomic counter, the classic
// stream compaction pattern.

#include "common.glsl"

layout(std430, binding = 0) readonly buffer DiffBuffer  { float diff[]; };
layout(std430, binding = 1) readonly buffer MeanBuffer  { float diffMean[]; };
layout(std430, binding = 2) readonly buffer StdBuffer   { float diffStd[]; };
layout(std430, binding = 3) buffer CounterBuffer        { uint detectionCount; };
layout(std430, binding = 4) writeonly buffer OutBuffer  { Detection detections[]; };

// Difference value at (x, y) with the coordinates clamped to the frame.
float diffAt(int x, int y) {
    int w = int(pc.width);
    int h = int(pc.height);
    return diff[clamp(y, 0, h - 1) * w + clamp(x, 0, w - 1)];
}

void main() {
    if (pc.hasPrev == 0u) {
        return;
    }

    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;
    if (gx >= pc.width || gy >= pc.height) {
        return;
    }

    int x = int(gx);
    int y = int(gy);
    uint i = gy * pc.width + gx;

    float center = diff[i];
    if (center <= 0.0) {
        return;
    }

    float significance = (center - diffMean[i]) / diffStd[i];
    if (significance < pc.detectSigma) {
        return;
    }

    // Local maximum test over the 3x3 neighbourhood of the difference image.
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if ((dx != 0 || dy != 0) && diffAt(x + dx, y + dy) > center) {
                return;
            }
        }
    }

    // Point spread function shape test: the four direct neighbours should carry
    // a fair fraction of the centre. A lone noise spike fails this.
    if (pc.shapeRatio > 0.0) {
        float up = diffAt(x, y - 1);
        float down = diffAt(x, y + 1);
        float left = diffAt(x - 1, y);
        float right = diffAt(x + 1, y);
        float neighbourMean = 0.25 * (up + down + left + right);
        if (neighbourMean < pc.shapeRatio * center) {
            return;
        }
    }

    uint slot = atomicAdd(detectionCount, 1u);
    if (slot < pc.maxDetections) {
        detections[slot] = Detection(gx, gy, center, significance);
    }
}
