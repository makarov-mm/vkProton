#version 460
#extension GL_GOOGLE_include_directive : require

// Stage 1: sensor calibration.
// Applies master bias subtraction and flat field correction to a raw frame.
// calibrated = (raw - bias) * flatInv
// This mirrors the first step of any real photometric pipeline, where the
// detector response is removed before any science measurement is attempted.

#include "common.glsl"

layout(std430, binding = 0) readonly buffer RawBuffer     { float raw[]; };
layout(std430, binding = 1) readonly buffer BiasBuffer    { float bias[]; };
layout(std430, binding = 2) readonly buffer FlatInvBuffer { float flatInv[]; };
layout(std430, binding = 3) writeonly buffer CalibBuffer  { float calibrated[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) {
        return;
    }
    uint i = y * pc.width + x;
    calibrated[i] = max((raw[i] - bias[i]) * flatInv[i], 0.0);
}
