#version 460
#extension GL_GOOGLE_include_directive : require

// Stage 2: difference imaging.
// Subtracts the previous calibrated frame from the current one. Static sources
// cancel out, so what remains is anything that appeared, vanished or changed
// brightness between the two exposures. This is the core trick behind transient
// surveys: you do not search the sky, you search the difference of the sky.

#include "common.glsl"

layout(std430, binding = 0) readonly buffer CalibBuffer { float calibrated[]; };
layout(std430, binding = 1) readonly buffer PrevBuffer  { float prevCalibrated[]; };
layout(std430, binding = 2) writeonly buffer DiffBuffer { float diff[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) {
        return;
    }
    uint i = y * pc.width + x;
    diff[i] = pc.hasPrev != 0u ? calibrated[i] - prevCalibrated[i] : 0.0;
}
